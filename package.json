{
	"name": "davidnet-backend",
	"type": "module",
	"scripts": {
		"dev": "bun run meta/scripts/setup.ts && bun run --hot src/index.ts",
		"build": "bun run meta/scripts/setup.ts && bun build ./src/index.ts --target=bun --sourcemap --outdir ./dist",
		"db:migrate": "bun --bun drizzle-kit migrate && bun run ./meta/scripts/seedPermissions.ts",
		"db:generate": "bun --bun drizzle-kit generate",
		"fmt": "bun x prettier --write . '!./volumes' && bun x eslint . --fix",
		"lint": "bun x prettier --check . '!./volumes' && bun x eslint ."
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1106.0",
		"@eslint/compat": "^2.0.3",
		"@eslint/js": "^10.0.1",
		"@hono/standard-validator": "^0.2.2",
		"@types/country-list": "^2.1.4",
		"arktype": "^2.2.0",
		"country-list": "^2.4.1",
		"drizzle-orm": "^0.45.1",
		"eslint": "^10.1.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-simple-import-sort": "^12.1.1",
		"globals": "^17.4.0",
		"hono": "^4.12.1",
		"husky": "^9.1.7",
		"jose": "^6.2.8",
		"nodemailer": "^9.0.1",
		"otplib": "^13.4.1",
		"pdfkit": "^0.19.1",
		"postgres": "^3.4.8",
		"prettier": "^3.8.1",
		"typescript-eslint": "^8.58.0",
		"ua-parser-js": "^2.0.10",
		"uuid": "^13.0.0"
	},
	"lint-staged": {
		"**/*.{js,ts,svelte,json,css}": [
			"prettier --write",
			"eslint --fix"
		],
		"src/core/database/schema/**": [
			"echo 'Dont forget to run: bun run db:generate'. Not automated anymore due interactiveness"
		]
	},
	"devDependencies": {
		"@types/bun": "^1.3.12",
		"@types/nodemailer": "^8.0.1",
		"@types/pdfkit": "^0.17.6",
		"@types/uuid": "^10.0.0",
		"drizzle-kit": "^0.31.9"
	}
}