# Dont forget to change the url accordingly!
DB_USER=davidnet
DB_PASSWORD=64charpassword
DB_NAME=davidnet_db

# Password in DATABASE_URL needs to be URL ENCODED!
DATABASE_URL=postgres://davidnet:64charpassword@localhost:5432/davidnet_db

# Used to verify with the frontend if correctly configured.
BACKEND_URL=http://localhost:3020

JWT_REFRESH_SECRET=64charstring
JWT_ACCESS_SECRET=64charstring

EMAIL=""
EMAIL_PASSWORD=""

# S3 (Garage). In prod this is left unset so s3.ts falls back to the in-cluster endpoint.
# For local dev, point this at the Garage container from docker-compose.yaml and use the
# same access/secret key it bootstraps (see garage/init.sh).
GARAGE_ENDPOINT=http://localhost:3900
GARAGE_ACCESS_KEY=devaccesskeydevaccesskey
GARAGE_SECRET_KEY=devsecretkeydevsecretkeydevsecretkeydevsecretkey
